# sdd-engine — local configuration.
#
# THIS IS THE ONE FILE YOU EDIT TO REPOINT THE ENGINE. Nothing else in the tree names a
# root; every call site resolves through tools/repo-dsl/engine/corpus-root.js, which
# reads this file.
#
# Precedence per root (highest first):
#   1. --source <path> / --corpus <path>   per-invocation CLI flag
#   2. SOURCE= / CORPUS= in the environment
#   3. this file
#   4. built-in default                    <engine>/Examples/hydra-source
#
# A path set here that does not exist FAILS LOUDLY and names this file as the source.
# It never silently falls back to the default.

# SOURCE — the READ root. The .ts tree the engine walks and mines. Never written.
SOURCE=Examples/hydra-source

# CORPUS — the WRITE root. Holds sen/ (the English output, and the mined artifacts under
# sen/catalog/) plus every derived tree (.cache/, catalog/). Never mined for .ts.
CORPUS=Examples/hydra-source

# Set both to the SAME directory to self-host — read and write in one tree, which is the
# default and today's behaviour. Set them to DIFFERENT directories to render a copied or
# forked codebase (SOURCE) into a fresh tree (CORPUS). Absolute paths are used as given;
# relative paths resolve against the sdd-engine skill root.
#
# `sen` is a FOLDER NAME inside CORPUS, not a root — it is not configured here. It is
# defined once, as LAYOUT.sen, in tools/repo-dsl/engine/corpus-root.js.
