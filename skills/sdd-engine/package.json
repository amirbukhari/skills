{
  "name": "sdd-engine",
  "version": "0.1.0",
  "private": true,
  "description": "SDD engine skill root. The code lives in tools/repo-dsl; these scripts delegate there so the whole thing is runnable from the skill root. Roots (SOURCE, CORPUS) are set in ./.env — see tools/PRD.md §1B and ./CLAUDE.md.",
  "scripts": {
    "test": "npm --prefix tools/repo-dsl test",
    "test:unit": "npm --prefix tools/repo-dsl run test:unit",
    "test:corpus": "npm --prefix tools/repo-dsl run test:corpus",
    "test:slow": "npm --prefix tools/repo-dsl run test:slow",
    "test:all": "npm --prefix tools/repo-dsl run test:all",
    "roots": "npm --prefix tools/repo-dsl run roots",
    "steps": "npm --prefix tools/repo-dsl run steps",
    "status": "npm --prefix tools/repo-dsl run status",
    "sdd-run": "npm --prefix tools/repo-dsl run sdd-run --",
    "mine": "npm --prefix tools/repo-dsl run mine",
    "name": "npm --prefix tools/repo-dsl run name",
    "render": "npm --prefix tools/repo-dsl run render",
    "measure": "npm --prefix tools/repo-dsl run measure",
    "stamp:check": "npm --prefix tools/repo-dsl run stamp:check",
    "register": "npm --prefix tools/repo-dsl run register",
    "register:json": "npm --prefix tools/repo-dsl run register:json",
    "reconcile": "npm --prefix tools/repo-dsl run reconcile",
    "measure:uncollapsed": "npm --prefix tools/repo-dsl run measure:uncollapsed",
    "gate": "npm --prefix tools/repo-dsl run gate",
    "clean": "npm --prefix tools/repo-dsl run clean",
    "clean:sen": "npm --prefix tools/repo-dsl run clean:sen",
    "build": "npm --prefix tools/repo-dsl run build"
  },
  "engines": {
    "node": ">=18"
  }
}
