[
  {
    "name": "half-cent rounds up via epsilon",
    "call": {
      "fn": "roundFloatToCents",
      "args": [
        1.005
      ]
    },
    "expect": 1.01
  },
  {
    "name": "classic float case",
    "call": {
      "fn": "roundFloatToCents",
      "args": [
        2.675
      ]
    },
    "expect": 2.68
  },
  {
    "name": "roundFloatToCents(0.015) => 0.02",
    "call": {
      "fn": "roundFloatToCents",
      "args": [
        0.015
      ]
    },
    "expect": 0.02
  },
  {
    "name": "below half rounds down",
    "call": {
      "fn": "roundFloatToCents",
      "args": [
        1.004
      ]
    },
    "expect": 1
  },
  {
    "name": "negative keeps sign",
    "call": {
      "fn": "roundFloatToCents",
      "args": [
        -0.01
      ]
    },
    "expect": -0.01
  },
  {
    "name": "negative classic",
    "call": {
      "fn": "roundFloatToCents",
      "args": [
        -2.675
      ]
    },
    "expect": -2.68
  },
  {
    "name": "repeating decimal to nearest",
    "call": {
      "fn": "roundFloatToCents",
      "args": [
        33.33333333
      ]
    },
    "expect": 33.33
  },
  {
    "name": "algorithm 'up' ceils",
    "call": {
      "fn": "roundFloatToCents",
      "args": [
        1.001,
        "up"
      ]
    },
    "expect": 1.01
  },
  {
    "name": "algorithm 'down' floors",
    "call": {
      "fn": "roundFloatToCents",
      "args": [
        1.009,
        "down"
      ]
    },
    "expect": 1
  },
  {
    "name": "already cents, stays valid",
    "call": {
      "fn": "roundFloatToCents",
      "args": [
        25
      ]
    },
    "expect": 25,
    "properties": [
      {
        "roundsToCents": true
      }
    ]
  }
]
